rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidOrder() {
      let d = request.resource.data;
      return d.keys().hasAll(['userId','userEmail','gameId','gameName',
                               'packageId','packageName','price',
                               'playerId','whatsapp','paymentMethod','status','createdAt'])
          && d.userId == request.auth.uid
          && d.price is number && d.price > 0
          && d.status == 'pending';
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Read own profile OR admin reads any
      allow read: if isOwner(userId) || isAdmin();
      // Create own profile on registration
      allow create: if isOwner(userId)
          && request.resource.data.role == 'user'
          && request.resource.data.uid == userId;
      // Update own profile (cannot change role)
      allow update: if isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          || isAdmin();
      // No delete
      allow delete: if false;
    }

    // ── Games (public read, admin write) ─────────────────────────────────────
    match /games/{gameId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /packages/{packageId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    // ── Banners (public read, admin write) ───────────────────────────────────
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Orders ───────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // User reads own orders; admin reads all
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // Create: must be signed in, own order, status=pending
      allow create: if isSignedIn() && isValidOrder();
      // Update: only admin can update (change status, add note)
      allow update: if isAdmin()
          && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['userId','userEmail','createdAt']);
      // No delete
      allow delete: if false;
    }

    // ── Settings (admin only write, authenticated read) ───────────────────────
    match /settings/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Support tickets ──────────────────────────────────────────────────────
    match /support/{ticketId} {
      allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;
      allow read, update: if isAdmin()
          || isOwner(resource.data.userId);
      allow delete: if false;
    }
  }
}
